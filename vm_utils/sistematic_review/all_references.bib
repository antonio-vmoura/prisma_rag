@CONFERENCE{Azad2019406,
	author = {Azad, Reza and Asadi-Aghbolaghi, Maryam and Fathy, Mahmood and Escalera, Sergio},
	title = {Bi-directional ConvLSTM U-net with densley connected convolutions},
	year = {2019},
	journal = {Proceedings - 2019 International Conference on Computer Vision Workshop, ICCVW 2019},
	pages = {406 – 415},
	doi = {10.1109/ICCVW.2019.00052},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85082445435&doi=10.1109%2fICCVW.2019.00052&partnerID=40&md5=aff560860b47e08c517aea0c7a4d1505},
	affiliations = {Sharif University of Technology, Iran; Inst. for Research in Fundamental Sciences (IPM), Iran; Iran University of Science and Tech., Iran; Universitat de Barcelona and Computer Vision Center, Spain},
	abstract = {In recent years, deep learning-based networks have achieved state-of-the-art performance in medical image segmentation. Among the existing networks, U-Net has been successfully applied on medical image segmentation. In this paper, we propose an extension of U-Net, Bi-directional ConvLSTM U-Net with Densely connected convolutions (BCDU-Net), for medical image segmentation, in which we take full advantages of U-Net, bi-directional ConvLSTM (BConvLSTM) and the mechanism of dense convolutions. Instead of a simple concatenation in the skip connection of U-Net, we employ BConvLSTM to combine the feature maps extracted from the corresponding encoding path and the previous decoding up-convolutional layer in a non-linear way. To strengthen feature propagation and encourage feature reuse, we use densely connected convolutions in the last convolutional layer of the encoding path. Finally, we can accelerate the convergence speed of the proposed network by employing batch normalization (BN). The proposed model is evaluated on three datasets of: retinal blood vessel segmentation, skin lesion segmentation, and lung nodule segmentation, achieving state-of-the-art performance. © 2019 IEEE.},
	author_keywords = {BConvLSTM; Convolutional neural networks; Medical imaging; Semantic segmentation; U net},
	keywords = {Backpropagation; Blood vessels; Computer vision; Convolution; Convolutional neural networks; Deep learning; Encoding (symbols); Medical image processing; Medical imaging; Semantics; Signal encoding; BConvLSTM; Bi-directional; Convergence speed; Feature reuse; Lung nodule segmentation; Retinal blood vessels; Semantic segmentation; State-of-the-art performance; Image segmentation},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {978-172815023-9},
	language = {English},
	abbrev_source_title = {Proc. - Int. Conf. Comput. Vis. Workshop, ICCVW},
	type = {Conference paper},
