@CONFERENCE{Liu202220665,
	author = {Liu, Fengbei and Tian, Yu and Chen, Yuanhong and Liu, Yuyuan and Belagiannis, Vasileios and Carneiro, Gustavo},
	title = {ACPL: Anti-curriculum Pseudo-labelling for Semi-supervised Medical Image Classification},
	year = {2022},
	journal = {Proceedings of the IEEE Computer Society Conference on Computer Vision and Pattern Recognition},
	volume = {2022-June},
	pages = {20665 – 20674},
	doi = {10.1109/CVPR52688.2022.02004},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85138192829&doi=10.1109%2fCVPR52688.2022.02004&partnerID=40&md5=3014f75d8a546b147bc466d01570ec08},
	affiliations = {Australian Institute for Machine Learning, University of Adelaide, Australia; Universität Ulm, Germany},
	abstract = {Effective semi-supervised learning (SSL) in medical image analysis (MIA) must address two challenges: 1) work effectively on both multi-class (e.g., lesion classification) and multi-label (e.g., multiple-disease diagnosis) problems, and 2) handle imbalanced learning (because of the high variance in disease prevalence). One strategy to explore in SSL MIA is based on the pseudo labelling strategy, but it has a few shortcomings. Pseudo-labelling has in general lower accuracy than consistency learning, it is not specifically design for both multi-class and multi-label problems, and it can be challenged by imbalanced learning. In this paper, unlike traditional methods that select confident pseudo label by threshold, we propose a new SSL algorithm, called anti-curriculum pseudo-labelling (ACPL), which introduces novel techniques to select informative unlabelled samples, improving training balance and allowing the model to work for both multi-label and multi-class problems, and to estimate pseudo labels by an accurate ensemble of classifiers (improving pseudo label accuracy). We run extensive experiments to evaluate ACPL on two public medical image classification benchmarks: Chest X-Ray 14 for thorax disease multi-label classification and ISIC2018 for skin lesion multi-class classification. Our method outperforms previous SOTA SSL methods on both datasets 11Supported by Australian Research Council through grants DP180103232 and FT190100525. 22Code is available at https://github.com/FBLADL/ACPL. © 2022 IEEE.},
	author_keywords = {biological and cell microscopy; Medical},
	keywords = {Classification (of information); Computer aided diagnosis; Image classification; Learning systems; Medical imaging; Supervised learning; Biological and cell microscopy; Imbalanced Learning; Labelings; Lesion classification; Medical; Medical image analysis; Medical image classification; Multi-labels; Semi-supervised; Semi-supervised learning; Curricula},
